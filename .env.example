# copy to .env and fill in. .env is gitignored; this file is not.
# There is no database credential to set: synapse is a local SQLite file.

# The model behind `synapse ask`. One string, any pydantic-ai provider.
# The prefix is the *provider*, which is the easy thing to get wrong:
#   openai:gpt-4o-mini             openai
#   anthropic:claude-sonnet-4-5   anthropic
#   deepseek:deepseek-chat         deepseek
#   moonshotai:kimi-k2.5           moonshotai              <- Kimi, not `kimi:`
#   google:gemini-2.5-flash        google                  <- Gemini, not `gemini:`
#   ollama:qwen2.5:32k             none: local, no key needed
# One variable holds every key as comma-separated `provider:key` pairs.
# Fill in only the providers you actually use.
PROVIDER_API_KEY="openai:sk-...,anthropic:sk-...,moonshotai:sk-..."
# only if Ollama is not on 11434
# OLLAMA_BASE_URL=http://localhost:11434/v1

# `synapse ask` answers with this one; scraping and extraction need no model at all.
MODEL=openai:gpt-4o-mini

# the browser half of scraping. Optional in every field: with no browser installed
# scraping degrades to plain HTTP and everything else is unaffected. Selenium Manager
# fetches the *driver*; the browser binary itself is the system's, so install
# Chrome/Chromium first. One browser per process, navigated under a lock.
# SELENIUM_BIN=/usr/bin/chromium     # only if it is not on PATH
# SELENIUM_HEADLESS=true
# SELENIUM_TIMEOUT=20.0              # page load and selector wait, both capped
# SELENIUM_EXTRA_ARGS=--no-sandbox   # only if you run as root in a container

# who OpenAlex/Crossref see. Optional but recommended: identifies the client for
# their polite pool instead of going anonymous.
# CONTACT_EMAIL=you@example.org

# operational tuning; the defaults suit most machines.
# HTTP_TIMEOUT=30.0
# HTTP_RETRIES=3
# WORKERS=4
# DOWNLOAD_CONCURRENCY=6

# how many chunks `ask` retrieves. Retrieval is keyword search over FTS5: no
# embeddings model, no vector index, nothing else to tune.
# RAG_TOP_K=8

# optional: where the database lives. Defaults to data/synapse.db under SYNAPSE_ROOT.
# DATABASE_URL=sqlite:///data/synapse.db
