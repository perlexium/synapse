# copy to .env and fill in. .env is gitignored; this file is not.
NEO4J_PASSWORD=change-me
# local (non-docker) use: the default NEO4J_URI already points at localhost:7687
# NEO4J_URI=bolt://localhost:7687

# only needed for `mhc scrape` / `mhc extract`
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL=openai:gpt-4o-mini
